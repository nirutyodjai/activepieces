{
  "mcpServers": {
    "nx-mcp": {
      "url": "http://localhost:9536/sse"
    },
    "figma-mcp": {
      "command": "npx",
      "args": ["@figma/mcp-server"],
      "env": {
        "FIGMA_ACCESS_TOKEN": "${FIGMA_ACCESS_TOKEN}"
      }
    },
    "activepieces-figma": {
      "command": "node",
      "args": ["packages/tools/figma/fetch-figma-file.js"],
      "env": {
        "FIGMA_TOKEN": "${FIGMA_TOKEN}",
        "FIGMA_FILE_ID": "${FIGMA_FILE_ID}"
      }
    },
    "replicate-flux-mcp": {
      "command": "node",
      "args": ["replicate-flux-mcp/build/index.js"],
      "env": {
        "REPLICATE_API_TOKEN": "${REPLICATE_API_TOKEN}"
      }
    },
    "filesystem-mcp": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem@latest",
        "d:\\Ai Server\\activepieces"
      ]
    },
    "git-mcp": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-git@latest",
        "--repository",
        "d:\\Ai Server\\activepieces"
      ]
    },
    "postgres-mcp": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-postgres@latest"
      ],
      "env": {
        "POSTGRES_CONNECTION_STRING": "${POSTGRES_CONNECTION_STRING}"
      }
    },
    "sqlite-mcp": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-sqlite@latest",
        "--db-path",
        "d:\\Ai Server\\activepieces\\app\\data\\powertech.db"
      ]
    },
    "brave-search-mcp": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-brave-search@latest"
      ],
      "env": {
        "BRAVE_API_KEY": "${BRAVE_API_KEY}"
      }
    },
    "github-mcp": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-github@latest"
      ],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "${GITHUB_PERSONAL_ACCESS_TOKEN}"
      }
    },
    "puppeteer-mcp": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-puppeteer@latest"
      ]
    },
    "memory-mcp": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-memory@latest"
      ]
    }
  }
}
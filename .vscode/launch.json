{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "backend",
            "port": 9229,
            "request": "attach",
            "skipFiles": [
                "<node_internals>/**",
                "**/node_modules/**"
            ],
            "type": "node",
            "localRoot": "${workspaceFolder}/packages/server/api",
            "remoteRoot": "/usr/src/app",
            "restart": true,
            "autoAttachChildProcesses": false
        },
        {
            "name": "Debug Replicate Flux MCP",
            "type": "node",
            "request": "launch",
            "program": "${workspaceFolder}/replicate-flux-mcp/build/index.js",
            "env": {
                "REPLICATE_API_TOKEN": "${env:REPLICATE_API_TOKEN}"
            },
            "console": "integratedTerminal",
            "skipFiles": [
                "<node_internals>/**",
                "**/node_modules/**"
            ]
        },
        {
            "name": "Debug Figma MCP",
            "type": "node",
            "request": "launch",
            "program": "${workspaceFolder}/packages/tools/figma/fetch-figma-file.js",
            "env": {
                "FIGMA_TOKEN": "${env:FIGMA_TOKEN}",
                "FIGMA_FILE_ID": "${env:FIGMA_FILE_ID}"
            },
            "console": "integratedTerminal",
            "skipFiles": [
                "<node_internals>/**",
                "**/node_modules/**"
            ]
        },
        {
            "name": "Test MCP Server Connection",
            "type": "node",
            "request": "launch",
            "program": "${workspaceFolder}/.vscode/test-mcp-connection.js",
            "console": "integratedTerminal",
            "skipFiles": [
                "<node_internals>/**",
                "**/node_modules/**"
            ]
        }
    ]
}

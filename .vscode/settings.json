{
    "cSpell.words": [
        "Activepieces",
        "Fastify",
        "mpim",
        "sendgrid",
        "replicate",
        "figma",
        "puppeteer",
        "postgres",
        "sqlite",
        "mcpServers"
    ],
    "editor.codeActionsOnSave": {
        "source.fixAll.eslint": "explicit"
    },
    "editor.formatOnSave": false,
    "typescript.tsdk": "node_modules/typescript/lib",
    "javascript.preferences.importModuleSpecifier": "relative",
    "nxConsole.generateAiAgentRules": true,
    "json.schemas": [
        {
            "fileMatch": [
                "**/mcp.json"
            ],
            "url": "./.vscode/mcp-schema.json"
        }
    ],
    "files.associations": {
        "mcp.json": "json",
        "*.mcp.json": "json"
    },
    "editor.quickSuggestions": {
        "strings": true
    },
    "editor.suggest.insertMode": "replace",
    "files.exclude": {
        "**/node_modules": true,
        "**/.git": true,
        "**/.DS_Store": true,
        "**/dist": true,
        "**/build": true,
        "**/.env.mcp": true
    },
    "search.exclude": {
        "**/node_modules": true,
        "**/dist": true,
        "**/build": true,
        "**/.env.mcp": true
    }
}
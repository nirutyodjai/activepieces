# Figma MCP Server Configuration
# Copy this file to .env and fill in your actual values

# Figma Personal Access Token
# Get from: https://www.figma.com/developers/api#access-tokens
FIGMA_ACCESS_TOKEN=your_figma_personal_access_token_here

# Alternative token name used by some tools
FIGMA_TOKEN=your_figma_personal_access_token_here

# Figma File ID from the URL
# Example: https://www.figma.com/file/ABC123/Your-Design-File
# The file ID would be: ABC123
FIGMA_FILE_ID=your_figma_file_id_here

# Instructions:
# 1. Create a Figma Personal Access Token at https://www.figma.com/developers/api#access-tokens
# 2. Copy the file ID from your Figma design URL
# 3. Copy this file to .env and replace the placeholder values
# 4. Restart your MCP servers after updating the environment variables